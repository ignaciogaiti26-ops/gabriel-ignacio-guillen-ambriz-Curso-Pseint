//Determina si una letra dada es vocal o no
Algoritmo Ejercicio019
	Definir letra Como Caracter;
	letra='  ';
	Escribir "Dime una letra";
	Leer letra; 
	Si letra='a' | letra='e' | letra='i' | letra='0' | letra='u' Entonces
		Escribir "La letra es una vocal";
	SiNo
		Escribir "La letra no es una vocal";
	FinSi
FinAlgoritmo
