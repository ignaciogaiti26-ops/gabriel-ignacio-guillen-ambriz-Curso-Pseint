//Diseña un programa que convierta una distancai en millas náuticas a metro
//1 milla náutica son 1852 metros 
Algoritmo Ejercicio004
	Definir millasNauticas, metros Como Real;
	millasNauticas=0; 
	metros=0; 
	Escribir "Conversor de Millas Naúticas a metros";
	Escribir "Ingresa el valor de distancia en millas náuticas: ";
	Leer millasNauticas;
	metros=millasNauticas+1852;
	Escribir "El resultado es: ", metros, "m";
	
FinAlgoritmo
